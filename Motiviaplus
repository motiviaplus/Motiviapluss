@charset "utf-8";

:root { --bg: #0c111b; --panel: #151d2b; --panel2: #1b2637; --text: #f2f5fb; --muted: #aab6c8; --line: #2b394e; --blue: #83b7ff; --mint: #8fe0c1; --gold: #f1cc83; --pink: #f0a9bd; }

* { box-sizing: border-box; }

body { margin: 0px; background: radial-gradient(at center top, rgb(26, 41, 64) 0px, rgb(12, 17, 27) 55%); color: var(--text); font: 16px / 1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }

.wrap { max-width: 1000px; margin: auto; padding: 28px 17px 60px; }

header { padding: 22px 4px 18px; }

.eyebrow { color: var(--mint); font-size: 0.76rem; font-weight: 800; letter-spacing: 0.16em; text-transform: uppercase; }

h1 { font-size: clamp(2rem, 6vw, 3.4rem); line-height: 1.05; margin: 9px 0px 10px; letter-spacing: -0.04em; }

.sub { color: var(--muted); max-width: 680px; margin: 0px; }

.topgrid { display: grid; grid-template-columns: 1.3fr 0.7fr; gap: 14px; margin: 16px 0px; }

.panel, .section { background: linear-gradient(145deg, rgba(27, 38, 55, 0.97), rgba(19, 28, 42, 0.97)); border: 1px solid var(--line); border-radius: 19px; padding: 18px; box-shadow: rgba(0, 0, 0, 0.133) 0px 12px 30px; }

.panel h2, .section h2 { margin: 0px 0px 8px; font-size: 1.12rem; }

.dateRow { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }

input[type="date"], input[type="time"], input[type="text"], textarea { background: rgb(13, 21, 34); color: var(--text); border: 1px solid rgb(58, 74, 98); border-radius: 10px; padding: 10px; font: inherit; min-width: 0px; }

input[type="date"] { width: 100%; }

textarea { width: 100%; resize: vertical; min-height: 90px; }

.progressTop { display: flex; justify-content: space-between; gap: 10px; color: var(--muted); font-size: 0.9rem; }

.track { height: 10px; border-radius: 20px; background: rgb(10, 16, 26); overflow: hidden; margin: 9px 0px 5px; }

.fill { height: 100%; width: 0px; background: linear-gradient(90deg,var(--blue),var(--mint)); border-radius: 20px; transition: width 0.2s; }

.small { font-size: 0.85rem; color: var(--muted); }

.grid { display: grid; grid-template-columns: repeat(2, minmax(0px, 1fr)); gap: 14px; }

.section { padding: 17px; }

.sectionHead { display: flex; justify-content: space-between; gap: 12px; align-items: flex-start; margin-bottom: 12px; }

.sectionHead h2 { font-size: 1.12rem; }

.emoji { font-size: 1.35rem; }

.timebox { display: flex; align-items: center; gap: 6px; color: var(--muted); font-size: 0.78rem; white-space: nowrap; }

.timebox input { width: 112px; padding: 7px; font-size: 0.86rem; }

ul { list-style: none; padding: 0px; margin: 0px; }

li { margin: 0px; border-top: 1px solid rgba(92, 111, 139, 0.18); }

label.task { display: flex; gap: 11px; align-items: flex-start; padding: 10px 2px; cursor: pointer; }

input[type="checkbox"] { appearance: none; flex: 0 0 19px; width: 19px; height: 19px; margin: 2px 0px 0px; border: 1.5px solid rgb(113, 131, 158); border-radius: 6px; background: rgb(16, 25, 39); cursor: pointer; }

input[type="checkbox"]:checked { background: var(--mint); border-color: var(--mint); }

input[type="checkbox"]:checked::after { content: "✓"; display: block; color: rgb(16, 35, 31); font-weight: 900; text-align: center; line-height: 17px; }

.task span { transition: color 0.15s; }

.task input:checked + span { color: rgb(145, 160, 181); text-decoration: line-through 1.5px; }

.full { grid-column: 1 / -1; }

.pillrow { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }

.pill { padding: 7px 10px; border: 1px solid var(--line); border-radius: 99px; color: var(--muted); font-size: 0.84rem; }

.quote { font-size: 1.02rem; color: rgb(233, 238, 248); margin: 6px 0px 0px; }

.priority { display: grid; grid-template-columns: repeat(4, 1fr); gap: 9px; margin-top: 12px; }

.priority div { background: rgb(16, 25, 39); border: 1px solid var(--line); border-radius: 13px; padding: 12px; }

.priority b { display: block; margin: 5px 0px 2px; font-size: 0.9rem; }

.priority span { font-size: 0.78rem; color: var(--muted); }

.actions { display: flex; flex-wrap: wrap; gap: 9px; margin: 17px 0px; }

button { border: 1px solid rgb(61, 82, 109); background: rgb(32, 50, 74); color: var(--text); padding: 10px 14px; border-radius: 11px; font: 600 0.9rem system-ui; cursor: pointer; }

button.primary { background: var(--mint); color: rgb(16, 35, 31); border-color: var(--mint); }

button:hover { filter: brightness(1.08); }

footer { color: var(--muted); font-size: 0.82rem; text-align: center; margin-top: 24px; }

@media (max-width: 700px) {
  .topgrid, .grid { grid-template-columns: 1fr; }
  .priority { grid-template-columns: repeat(2, 1fr); }
  .full { grid-column: auto; }
  .wrap { padding: 20px 13px 45px; }
}
